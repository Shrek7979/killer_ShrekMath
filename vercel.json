{
 "outputDirectory": "site",
 "cleanUrls": true,
 "headers": [
  {
   "source": "/(.*)\\.json",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=300"
    }
   ]
  },
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/.well-known/assetlinks.json",
   "headers": [
    {
     "key": "Content-Type",
     "value": "application/json"
    }
   ]
  }
 ]
}