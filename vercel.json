{
 "outputDirectory": "site",
 "cleanUrls": true,
 "headers": [
  {
   "source": "/((?!p/).*)\\.json",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=300"
    }
   ]
  },
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/.well-known/assetlinks.json",
   "headers": [
    {
     "key": "Content-Type",
     "value": "application/json"
    }
   ]
  },
  {
   "source": "/api/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-store"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/p/:path*",
   "destination": "/api/c?f=:path*"
  }
 ],
 "functions": {
  "api/c.js": {
   "includeFiles": "paid/**",
   "memory": 1024
  }
 }
}