 "intro": [
  "$r=1-\\frac a6$, $\\sum a_n^2=\\frac{36a}{12-a}$ → 약수 조건.",
  "$\\sum a_n^3$까지 자연수 → $a=9$."
 ],
 "topic": "급수",
 "concepts": [
