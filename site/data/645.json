 "intro": [
  "$a_na_{2n}=a^2r^{3n-2}$ — 공비 $r^3$.",
  "식 정리 → $r=-\\frac12$, $a=\\frac92$."
 ],
 "topic": "급수",
 "concepts": [
  {
   "h": "곱의 등비성",
   "p": [
    "$a_na_{kn}$의 공비 $r^{k+1}$."
   ]
  },
  {
   "h": "수렴 조건",
   "p": [
    "$|r|<1$."
   ]
  }
 ],
 "steps": [
  {
   "n": 1,
   "text": "$a_{n}=a r^{n-1}$ 이라 하면 급수가 수렴하므로 $-1<r<1$ 이고 $\\frac{a}{1-r}=3$ , 즉 $a=3(1-r)$ 이다.",
   "uses": [
    "C2"
   ],
   "title": "설정"
  },
  {
   "n": 2,
   "text": "$a_{n}a_{2 n}=a^{2}r^{3 n-2}=a^{2}r \\left(r^{3}\\right)^{n-1}$ 이므로",
   "uses": [
    "C2"
   ],
   "title": "공비"
  },
  {
   "n": 3,
   "text": "$$\\sum_{n=1}^{\\infty}a_{n}a_{2 n}=\\frac{a^{2}r}{1-r^{3}}=\\frac{9(1-r)r}{1+r+r^{2}}=-9$$",
   "uses": [
    "C2"
   ],
   "title": "방정식"
  },
  {
   "n": 4,
   "text": "에서 $r-r^{2}=-1-r-r^{2}$ , 즉 $r=-\\frac{1}{2}$ 이고 $a=\\frac{9}{2}$ 이다.",
   "uses": [
    "C2"
   ],
   "title": "값"
  },
  {
   "n": 5,
   "text": "$a_{n}a_{3 n}=a^{2}r^{4 n-2}=a^{2}r^{2}\\left(r^{4}\\right)^{n-1}$ 이므로",
   "uses": [
    "C4"
   ],
   "title": "공비"
  },
  {
   "n": 6,
   "text": "$$\\sum_{n=1}^{\\infty}a_{n}a_{3 n}=\\frac{a^{2}r^{2}}{1-r^{4}}=\\frac{\\frac{81}{4}\\times \\frac{1}{4}}{\\frac{15}{16}}=\\frac{27}{5}$$",
   "uses": [
    "C4"
   ],
   "title": "계산"
  },
  {
   "n": 7,
   "text": "이고, $p+q=5+27=32$ 이다.",
   "uses": [
    "C5"
   ],
   "title": "답"
  }
 ],
