 "intro": [
  "수렴 ⟺ $(x-1)^2<k+1<(x+1)^2$ → 자연수 $x$ 하나 ⟺ $k+1$이 제곱수.",
  "$k_m=(m+1)^2-1$, $S_m=\\frac1{2m+1}$ — 부분분수 망원."
 ],
 "topic": "수렴하게 하는 자연수가 하나뿐인 급수",
 "concepts": [
  {
   "h": "등비급수",
   "p": [
    "$|r|<1$일 때 $\\sum_{n=1}^\\infty ar^{n-1}=\\frac a{1-r}$."
   ]
  },
