 "intro": [
  "$\\sum|a_n|=20$, $\\sum a_n=10$ → $r=-\\frac13$, $a=\\frac{40}3$.",
  "$\\sin\\frac{k\\pi}2$: $1,0,-1,0$ → $\\frac{a_{m+1}}{1+r^2}=12\\left(-\\frac13\\right)^m$."
 ],
 "topic": "급수",
 "concepts": [
  {
   "h": "등비급수",
   "p": [
    "$\\sum ar^{n-1}=\\frac a{1-r}$, $|r|<1$."
   ]
  },
