   ]
  },
  {
   "t": "eq",
   "tex": "U=\\sum_{n=1}^{\\infty}\\left(x_{n}-m \\right),\\,\\,\\,V=\\sum_{n=1}^{\\infty}\\left\\{\\left(x_{n}-m \\right)^{2}+\\left(y_{n}-m \\right)^{2}+\\left(z_{n}-m \\right)^{2}\\right\\}"
  },
  {
   "t": "p",
