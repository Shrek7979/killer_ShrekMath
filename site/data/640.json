   ],
   "title": "치환"
  },
  {
   "n": 4,
   "text": "$$\\int_{\\frac{\\pi}{3}}^{\\frac{\\pi}{2}}f(\\theta)d \\theta=\\int_{0}^{\\frac{1}{2}}\\frac{u}{1-u}du=\\int_{0}^{\\frac{1}{2}}\\left(-1+\\frac{1}{1-u}\\right)du=\\left[-u-\\ln(1-u)\\right]_{0}^{\\frac{1}{2}}=-\\frac{1}{2}+\\ln 2$$",
   "uses": [
    "C4"
   ],
   "title": "적분"
