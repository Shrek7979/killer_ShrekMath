 "intro": [
  "$V_1=\\int x^2e^{2x}$.",
  "$V_2=\\int(1-g)^2dy$, $y=te^t$ 치환 → $I_n$ 점화식."
 ],
 "topic": "정적분의 활용",
 "concepts": [
  {
   "h": "역함수 치환",
   "p": [
    "$dy=(t+1)e^tdt$."
   ]
