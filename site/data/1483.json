 "intro": [
  "$F'=(2x+2)e^{-F}$ → $(e^F)'=2x+2$.",
  "$e^F=(x+1)^2$, $f=\\frac2{x+1}$."
 ],
 "topic": "정적분으로 정의된 함수 — 지수 안에 들어간 자기 자신의 적분",
 "concepts": [
  {
   "h": "적분으로 정의된 함수",
