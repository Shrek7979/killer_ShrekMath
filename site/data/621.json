 "intro": [
  "$P(X=k)=\\frac{{}_{n-k}\\mathrm C_2}{{}_n\\mathrm C_3}$.",
  "$\\sum k\\,{}_{n-k}\\mathrm C_2={}_{n+1}\\mathrm C_4$ → $\\mathrm E=\\frac{n+1}4$."
 ],
 "topic": "통계",
 "concepts": [
  {
   "h": "최솟값 분포",
   "p": [
    "나머지는 더 큰 수에서."
   ]
  },
  {
   "h": "조합적 항등식",
   "p": [
    "두 번째로 작은 수로 해석."
   ]
  }
 ],
 "steps": [
  {
   "n": 1,
   "text": "가장 작은 수가 $k$ 이려면 나머지 두 장을 $k+1$ 부터 $n$ 까지의 $n-k$ 개의 수 중에서 택해야 하므로",
   "uses": [
    "C1"
   ],
   "title": "세기"
  },
  {
   "n": 2,
   "text": "$${\\mathrm{P}}(X=k)=\\frac{_{n-k}{\\mathrm{C}}_{2}}{_{n}{\\mathrm{C}}_{3}}\\,\\,\\,(k=1,\\,2,\\,\\cdots,\\,n-2)$$",
   "uses": [
    "C1"
   ],
   "title": "분포"
  },
  {
   "n": 3,
   "text": "이다. $1$ 부터 $n+1$ 까지의 자연수 중에서 $4$ 개를 택할 때 두 번째로 작은 수가 $k+1$ 인 경우의 수는 그보다 작은 수 $1$ 개를 고르는 $k$ 가지와 그보다 큰 수 $2$ 개를 고르는 $_{n-k}{\\mathrm{C}}_{2}$ 가지의 곱이다. 따라서",
   "uses": [
    "C1"
   ],
   "title": "항등식"
  },
  {
   "n": 4,
   "text": "$$\\sum_{k=1}^{n-2}k \\times_{n-k}{\\mathrm{C}}_{2}=_{n+1}{\\mathrm{C}}_{4},\\,\\,\\,{\\mathrm{E}}(X)=\\frac{_{n+1}{\\mathrm{C}}_{4}}{_{n}{\\mathrm{C}}_{3}}=\\frac{n+1}{4}$$",
   "uses": [
    "C2"
   ],
   "title": "평균"
  },
  {
   "n": 5,
   "text": "이다. $\\frac{n+1}{4}=4$ 에서 $n=15$ 이다.",
   "uses": [
    "C2"
   ],
   "title": "$n$"
  },
  {
   "n": 6,
   "text": "$X \\ge 5$ 는 세 장이 모두 $5$ 부터 $15$ 까지의 수 중에서 나오는 사건이므로",
   "uses": [
    "C2"
   ],
   "title": "사건"
  },
  {
   "n": 7,
   "text": "$${\\mathrm{P}}(X \\ge 5)=\\frac{_{11}{\\mathrm{C}}_{3}}{_{15}{\\mathrm{C}}_{3}}=\\frac{165}{455}=\\frac{33}{91}$$",
   "uses": [
    "C2"
   ],
   "title": "계산"
  },
  {
   "n": 8,
   "text": "이고 $p+q=91+33=124$ 이다.",
   "uses": [
    "C4"
   ],
   "title": "답"
  }
 ],
