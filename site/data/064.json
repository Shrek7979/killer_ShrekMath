 "steps": [
  {
   "n": 1,
   "text": "진수 조건에서 $0<x<k$ 이고 부등식은 $x(k-x)\\ge 16$ 과 같다. $x(k-x)\\le \\frac{k^{2}}{4}$ 이므로 $k \\le 7$ 이면 $f(k)=0$ 이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 2,
   "text": "$k=8$ : $x=4$ 뿐이므로 $1$ , $k=9$ : $x=3,\\,4,\\,5,\\,6$ 이므로 $4$ , $k=10$ : $x=2,\\,\\cdots,\\,8$ 이므로 $7$",
   "uses": [],
   "title": ""
  },
  {
   "n": 3,
   "text": "$k=11$ : $x=2,\\,\\cdots,\\,9$ 이므로 $8$ , $k=12$ : $x=2,\\,\\cdots,\\,10$ 이므로 $9$",
   "uses": [],
   "title": ""
  },
  {
   "n": 4,
   "text": "따라서 구하는 값은 $1+4+7+8+9=29$",
   "uses": [],
   "title": ""
  }
 ],
