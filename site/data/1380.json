 "intro": [
  "$u=\\frac1f-1$ → $u'=-u$.",
  "$e^xu$가 상수 → $f=\\frac1{1+2e^{-x}}$."
 ],
 "topic": "몫의 미분 — f'=f(1−f)를 만족시키는 함수를 미분법만으로 결정",
 "concepts": [
  {
   "h": "몫의 미분",
   "p": [
    "$\\left(\\frac1f\\right)'=-\\frac{f'}{f^2}$."
   ]
  },
  {
   "h": "도함수 $0$",
