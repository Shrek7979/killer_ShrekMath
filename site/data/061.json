 "steps": [
  {
   "n": 1,
   "text": "$n \\ge 2$ 일 때 $a_{n+1}=\\sum_{k=1}^{n+1}a_{k}-\\sum_{k=1}^{n}a_{k}=\\frac{1}{2}(a_{n+1}-a_{n})+2 n+2$ 이므로 $a_{n}+a_{n+1}=4 n+4$ $(n \\ge 2)$ 이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 2,
   "text": "$n=2$ 를 대입하면 $4+a_{2}=\\frac{1}{2}a_{2}+6$ 에서 $a_{2}=4$ , 따라서 $a_{3}=12-4=8$ 이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 3,
   "text": "$$\\sum_{k=1}^{21}a_{k}=a_{1}+\\sum_{m=1}^{10}(a_{2 m}+a_{2 m+1})=4+\\sum_{m=1}^{10}(8 m+4)=4+440+40=484$$",
   "uses": [],
   "title": ""
  },
  {
   "n": 4,
   "text": "$a_{n+2}-a_{n}=4$ $(n \\ge 2)$ 이므로 $a_{2 k+1}=4 k+4$ 이고 $\\sum_{k=1}^{10}a_{2 k+1}=220+40=260$",
   "uses": [],
   "title": ""
  },
  {
   "n": 5,
   "text": "따라서 구하는 값은 $484+260=744$",
   "uses": [],
   "title": ""
  }
 ],
