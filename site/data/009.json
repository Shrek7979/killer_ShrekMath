 "steps": [
  {
   "n": 1,
   "text": "$a_{n}=k$이면 $10^{k-1}\\le 2^{n}<10^{k}$이므로 $10^{k-1}<2^{n+1}<10^{k+1}$이다. 따라서 $a_{n+1}-a_{n}$의 값은 $0$ 또는 $1$이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 2,
   "text": "그러므로 $100$ 이하의 자연수 $n$ 중 $a_{n+1}=a_{n}+1$인 $n$의 개수는 $\\sum_{n=1}^{100}(a_{n+1}-a_{n})=a_{101}-a_{1}$과 같다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 3,
   "text": "$\\log 2^{101}=101 \\times 0.3010=30.401$이므로 $a_{101}=31$이고 $a_{1}=1$이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 4,
   "text": "$a_{n+1}=a_{n}+1$인 $n$이 $30$개이므로 구하는 개수는 $100-30=70$",
   "uses": [],
   "title": ""
  }
 ],
