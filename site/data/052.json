 "steps": [
  {
   "n": 1,
   "text": "$\\sin(x+t)=\\sin x \\cos t+\\cos x \\sin t$이므로 $A=\\frac{1}{\\pi}\\int_{0}^{\\pi}f(t)\\cos t dt$, $B=\\frac{1}{\\pi}\\int_{0}^{\\pi}f(t)\\sin t dt$라 하면 $f(x)=A \\sin x+(1+B)\\cos x$",
   "uses": [],
   "title": ""
  },
  {
   "n": 2,
   "text": "$\\int_{0}^{\\pi}\\cos^{2}t dt=\\int_{0}^{\\pi}\\sin^{2}t dt=\\frac{\\pi}{2}$, $\\int_{0}^{\\pi}\\sin t \\cos t dt=0$이므로 $A=\\frac{1+B}{2}$, $B=\\frac{A}{2}$",
   "uses": [],
   "title": ""
  },
  {
   "n": 3,
   "text": "연립하면 $A=\\frac{2}{3}$, $B=\\frac{1}{3}$이므로 $f(x)=\\frac{2}{3}\\sin x+\\frac{4}{3}\\cos x$",
   "uses": [],
   "title": ""
  },
  {
   "n": 4,
   "text": "$M^{2}=\\frac{4}{9}+\\frac{16}{9}=\\frac{20}{9}$이므로 $9 M^{2}=20$",
   "uses": [],
   "title": ""
  }
 ],
