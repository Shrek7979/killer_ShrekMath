 "steps": [
  {
   "n": 1,
   "text": "$$\\left\\{x \\{f(x)\\}^{2}\\right\\}'=\\{f(x)\\}^{2}+2 x f(x)f'(x)=f(x)\\left\\{f(x)+2 x f'(x)\\right\\}=2 x+2$$",
   "uses": [],
   "title": ""
  },
  {
   "n": 2,
   "text": "이므로 $x \\{f(x)\\}^{2}=x^{2}+2 x+C$ 이다. $x=1$ 을 대입하면 $4=3+C$ , $C=1$ 이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 3,
   "text": "$\\{f(x)\\}^{2}=\\frac{(x+1)^{2}}{x}$ 이고 $f(x)>0$ 이므로 $f(x)=\\frac{x+1}{\\sqrt{x}}=x^{\\frac{1}{2}}+x^{-\\frac{1}{2}}$ 이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 4,
   "text": "$$\\int_{1}^{4}f(x)dx=\\left[\\frac{2}{3}x^{\\frac{3}{2}}+2 x^{\\frac{1}{2}}\\right]_{1}^{4}=\\left(\\frac{16}{3}+4 \\right)-\\left(\\frac{2}{3}+2 \\right)=\\frac{20}{3}$$",
   "uses": [],
   "title": ""
  },
  {
   "n": 5,
   "text": "따라서 $p+q=3+20=23$ 이다.",
   "uses": [],
   "title": ""
  }
 ],
