 "steps": [
  {
   "n": 1,
   "text": "임의의 $a$, $b$에 대하여 성립하므로 $\\int_{0}^{1}f(x)dx=0$, $\\int_{0}^{1}x f(x)dx=0$이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 2,
   "text": "$f(x)=x^{2}+m x+n$이라 하면 $\\frac{1}{3}+\\frac{m}{2}+n=0$, $\\frac{1}{4}+\\frac{m}{3}+\\frac{n}{2}=0$에서 $m=-1$, $n=\\frac{1}{6}$",
   "uses": [],
   "title": ""
  },
  {
   "n": 3,
   "text": "$\\left\\{f(x)\\right\\}^{2}=x^{2}f(x)+\\left(-x+\\frac{1}{6}\\right)f(x)$이고 주어진 조건에서 $\\int_{0}^{1}\\left(-x+\\frac{1}{6}\\right)f(x)dx=0$이므로",
   "uses": [],
   "title": ""
  },
  {
   "n": 4,
   "text": "$\\int_{0}^{1}\\left\\{f(x)\\right\\}^{2}dx=\\int_{0}^{1}x^{2}f(x)dx=\\frac{1}{5}-\\frac{1}{4}+\\frac{1}{18}=\\frac{1}{180}$",
   "uses": [],
   "title": ""
  },
  {
   "n": 5,
   "text": "따라서 $p+q=180+1=181$",
   "uses": [],
   "title": ""
  }
 ],
