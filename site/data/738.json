 "intro": [
  "$\\alpha_n=\\theta_{n+1}-\\theta_{n-1}$ ($\\tan\\theta_m=m$).",
  "부분합 $\\theta_{n+1}+\\theta_n-\\frac\\pi4$; 나머지 $\\varphi\\sim\\frac1m$."
 ],
 "topic": "급수",
 "concepts": [
  {
   "h": "두 칸 망원",
   "p": [
    "$\\frac{(n+1)-(n-1)}{1+(n^2-1)}$."
   ]
  },
  {
   "h": "$\\frac{\\tan x}x\\to1$",
   "p": [
    "여각의 극한."
   ]
  }
 ],
 "steps": [
  {
   "n": 1,
   "text": "$0<\\theta_{m}<\\frac{\\pi}{2}$ , $\\tan \\theta_{m}=m$ $(m \\ge 1)$ , $\\theta_{0}=0$ 이라 하자. 탄젠트의 덧셈정리에서",
   "uses": [
    "C2"
   ],
   "title": "설정"
  },
  {
   "n": 2,
   "text": "$$\\tan \\left(\\theta_{n+1}-\\theta_{n-1}\\right)=\\frac{(n+1)-(n-1)}{1+(n+1)(n-1)}=\\frac{2}{n^{2}}$$",
   "uses": [
    "C2"
   ],
   "title": "분해"
  },
  {
   "n": 3,
   "text": "이고 $0<\\theta_{n+1}-\\theta_{n-1}<\\frac{\\pi}{2}$ 이므로 $\\alpha_{n}=\\theta_{n+1}-\\theta_{n-1}$ 이다. 따라서 부분합은 두 항씩 남아",
   "uses": [
    "C1"
   ],
   "title": "범위"
  },
  {
   "n": 4,
   "text": "$$\\sum_{j=1}^{n}\\alpha_{j}=\\theta_{n+1}+\\theta_{n}-\\theta_{1}-\\theta_{0}=\\theta_{n+1}+\\theta_{n}-\\frac{\\pi}{4}$$",
   "uses": [
    "C4"
   ],
   "title": "부분합"
  },
  {
   "n": 5,
   "text": "이다. $\\theta_{m}\\to \\frac{\\pi}{2}$ 이므로 급수의 합은 $\\frac{3 \\pi}{4}$ , 즉 $k=\\frac{3}{4}$ 이다.",
   "uses": [
    "C4"
   ],
   "title": "$k$"
  },
  {
   "n": 6,
   "text": "$\\varphi_{m}=\\frac{\\pi}{2}-\\theta_{m}$ 이라 하면 $\\tan \\varphi_{m}=\\frac{1}{m}$ , $\\varphi_{m}\\to 0$ 이고",
   "uses": [
    "C4"
   ],
   "title": "여각"
  },
  {
   "n": 7,
   "text": "$$n \\left(\\frac{3 \\pi}{4}-\\sum_{j=1}^{n}\\alpha_{j}\\right)=n \\varphi_{n+1}+n \\varphi_{n}=\\frac{\\varphi_{n+1}}{\\tan \\varphi_{n+1}}\\times \\frac{n}{n+1}+\\frac{\\varphi_{n}}{\\tan \\varphi_{n}}\\to 2$$",
   "uses": [
    "C4"
   ],
   "title": "극한"
  },
  {
   "n": 8,
   "text": "이므로 $L=2$ 이다. 구하는 값은 $75+20=95$ 이다.",
   "uses": [
    "C4"
   ],
   "title": "답"
  }
 ],
 "traps": [
