 "steps": [
  {
   "n": 1,
   "text": "$a_{n+1}=v$ 일 때 가능한 $a_{n}$ 은 $3 v$ 와, $v-2$ 가 $3$ 의 배수가 아닌 자연수일 때의 $v-2$ 이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 2,
   "text": "$a_{6}=1$ 에서 $a_{5}=3$ , $a_{4}=9$ 또는 $1$ , $a_{3}=27,\\,7$ 또는 $3$ 이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 3,
   "text": "$a_{2}$ 는 $a_{3}=27$ 에서 $81,\\,25$ , $a_{3}=7$ 에서 $21,\\,5$ , $a_{3}=3$ 에서 $9,\\,1$ 이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 4,
   "text": "$a_{1}$ 은 $81$ 에서 $243,\\,79$ , $25$ 에서 $75,\\,23$ , $21$ 에서 $63,\\,19$ , $5$ 에서 $15$ ( $3$ 은 $3$ 의 배수이므로 제외), $9$ 에서 $27,\\,7$ , $1$ 에서 $3$ 이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 5,
   "text": "따라서 구하는 합은 $243+79+75+23+63+19+15+27+7+3=554$",
   "uses": [],
   "title": ""
  }
 ],
