 "steps": [
  {
   "n": 1,
   "text": "$k \\ge 4$일 때 차례로 구하면 $a_{3}=k-2$, $a_{4}=-2$, $a_{5}=4-k$, $a_{6}=k-2$, $a_{7}=2 k-6$, $a_{8}=k-4$, $a_{9}=2-k$, $a_{10}=2$, $a_{11}=k$",
   "uses": [],
   "title": ""
  },
  {
   "n": 2,
   "text": "따라서 모든 자연수 $n$에 대하여 $a_{n+9}=a_{n}$이고 $\\sum_{n=1}^{9}a_{n}=4 k-8$, $\\sum_{n=1}^{5}a_{n}=k+2$",
   "uses": [],
   "title": ""
  },
  {
   "n": 3,
   "text": "$50=9 \\times 5+5$이므로 $\\sum_{n=1}^{50}a_{n}=5(4 k-8)+(k+2)=21 k-38=109$에서 $k=7$",
   "uses": [],
   "title": ""
  },
  {
   "n": 4,
   "text": "$k=1,\\,2,\\,3$일 때도 항을 차례로 구하면 $a_{n+9}=a_{n}$이고, $\\sum_{n=1}^{50}a_{n}$의 값은 차례로 $23$, $44$, $45$이므로 조건을 만족시키지 않는다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 5,
   "text": "따라서 $k=7$",
   "uses": [],
   "title": ""
  }
 ],
