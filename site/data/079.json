 "steps": [
  {
   "n": 1,
   "text": "$a_{n+2}-a_{n}=3$ 이므로 $a_{1}=t$ 라 하면 $a_{2 m-1}=t+3 m-3$ , $a_{2 m}=3 m-t$ 이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 2,
   "text": "$u=t-\\frac{3}{2}$ 이라 하면 $a_{2 m-1}=\\left(3 m-\\frac{3}{2}\\right)+u$ , $a_{2 m}=\\left(3 m-\\frac{3}{2}\\right)-u$ 이므로 $a_{2 m-1}^{2}+a_{2 m}^{2}=2 \\left(3 m-\\frac{3}{2}\\right)^{2}+2 u^{2}$ 이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 3,
   "text": "$\\sum_{k=1}^{8}a_{k}^{2}=8 u^{2}+2 \\left(\\frac{9}{4}+\\frac{81}{4}+\\frac{225}{4}+\\frac{441}{4}\\right)=8 u^{2}+378$ 이므로 최솟값은 $u=0$ 일 때 $378$",
   "uses": [],
   "title": ""
  }
 ],
