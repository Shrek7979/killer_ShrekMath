 "steps": [
  {
   "n": 1,
   "text": "부분적분법에 의하여 $\\int_{\\frac{1}{e}}^{e}f'(x)\\ln x dx=\\left[f(x)\\ln x \\right]_{\\frac{1}{e}}^{e}-\\int_{\\frac{1}{e}}^{e}\\frac{f(x)}{x}dx=f(e)+f \\left(\\frac{1}{e}\\right)-I$ (단, $I=\\int_{\\frac{1}{e}}^{e}\\frac{f(x)}{x}dx$)",
   "uses": [],
   "title": ""
  },
  {
   "n": 2,
   "text": "$x=\\frac{1}{s}$로 놓으면 $I=\\int_{\\frac{1}{e}}^{e}\\frac{1}{s}f \\left(\\frac{1}{s}\\right)ds$이므로 $2 I=\\int_{\\frac{1}{e}}^{e}\\frac{1}{x}\\left(x^{2}+\\frac{1}{x^{2}}\\right)dx=\\left[\\frac{x^{2}}{2}-\\frac{1}{2 x^{2}}\\right]_{\\frac{1}{e}}^{e}=e^{2}-\\frac{1}{e^{2}}$",
   "uses": [],
   "title": ""
  },
  {
   "n": 3,
   "text": "$f(e)+f \\left(\\frac{1}{e}\\right)=e^{2}+\\frac{1}{e^{2}}$이므로 구하는 값은 $e^{2}+\\frac{1}{e^{2}}-\\frac{1}{2}\\left(e^{2}-\\frac{1}{e^{2}}\\right)=\\frac{1}{2}e^{2}+\\frac{3}{2 e^{2}}$",
   "uses": [],
   "title": ""
  },
  {
   "n": 4,
   "text": "따라서 $p=\\frac{1}{2}$, $q=\\frac{3}{2}$이고 $10(p^{2}+q^{2})=10 \\left(\\frac{1}{4}+\\frac{9}{4}\\right)=25$",
   "uses": [],
   "title": ""
  }
 ],
