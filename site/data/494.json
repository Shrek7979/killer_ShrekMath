 "intro": [
  "$\\{f+e^f\\}'=1$ → $H(f(x))=x$, $H(u)=u+e^u-1$.",
  "$x=H(u)$ 치환 → $\\int_0^1H\\cdot u\\cdot H'du$."
 ],
 "topic": "여러 가지 적분법",
 "concepts": [
  {
   "h": "역함수 인식",
   "p": [
    "$H\\circ f=\\mathrm{id}$."
   ]
  },
  {
   "h": "치환적분",
   "p": [
    "$x=H(u)$, $dx=H'du$."
   ]
  }
 ],
 "steps": [
  {
   "n": 1,
   "text": "$\\left\\{f(x)+e^{f(x)}\\right\\}'=f'(x)\\left\\{1+e^{f(x)}\\right\\}=1$ 이므로 $f(x)+e^{f(x)}=x+C$ 이고, $x=0$ 을 대입하면 $C=1$ 이다. 증가함수 $H(u)=u+e^{u}-1$ 에 대하여 $H(f(x))=x$ 이므로 $f$ 는 $H$ 의 역함수이다.",
   "uses": [
    "C2"
   ],
   "title": "적분"
  },
  {
   "n": 2,
   "text": "$H(1)=e$ 이므로 $f(e)=1$ 이다. $x=H(u)$ 로 치환하면 $u$ 는 $0$ 에서 $1$ 까지 변하고",
   "uses": [
    "C4"
   ],
   "title": "값"
  },
  {
   "n": 3,
   "text": "$$\\int_{0}^{e}x f(x)dx=\\int_{0}^{1}H(u)u H'(u)du=\\int_{0}^{1}\\left(u+e^{u}-1 \\right)u \\left(1+e^{u}\\right)du$$",
   "uses": [
    "C4"
   ],
   "title": "치환"
  },
  {
   "n": 4,
   "text": "피적분함수를 전개하면 $u^{2}-u+u^{2}e^{u}+u e^{2 u}$ 이다.",
   "uses": [
    "C4"
   ],
   "title": "전개"
  },
  {
   "n": 5,
   "text": "$\\int_{0}^{1}\\left(u^{2}-u \\right)du=-\\frac{1}{6}$ , $\\int_{0}^{1}u^{2}e^{u}du=\\left[\\left(u^{2}-2 u+2 \\right)e^{u}\\right]_{0}^{1}=e-2$ , $\\int_{0}^{1}u e^{2 u}du=\\left[\\left(\\frac{u}{2}-\\frac{1}{4}\\right)e^{2 u}\\right]_{0}^{1}=\\frac{e^{2}}{4}+\\frac{1}{4}$",
   "uses": [
    "C4"
   ],
   "title": "계산"
  },
  {
   "n": 6,
   "text": "이므로 $\\int_{0}^{e}x f(x)dx=\\frac{1}{4}e^{2}+e-\\frac{23}{12}$ 이다. $12 \\left(\\frac{1}{4}+1+\\frac{23}{12}\\right)=3+12+23=38$ 이다.",
   "uses": [
    "C4",
    "C5"
   ],
   "title": "답"
  }
 ],
