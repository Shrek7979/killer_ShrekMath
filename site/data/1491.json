 "intro": [
  "$x\\to1-x$로 하나 더 → 연립.",
  "$3f=2(1-x)e^{1-x}-xe^x$."
 ],
 "topic": "함수방정식 — x와 1-x를 바꾼 연립",
 "concepts": [
  {
   "h": "연립",
   "p": [
    "$f(x)$, $f(1-x)$."
   ]
  },
  {
   "h": "부분적분",
   "p": [
