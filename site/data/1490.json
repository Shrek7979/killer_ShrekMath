 "intro": [
  "$\\frac{\\cos x}{(1+\\sin x)^2}=\\left(-\\frac1{1+\\sin x}\\right)'$.",
  "$\\frac1{1+\\sin x}$의 부정적분 $-\\frac{\\cos x}{1+\\sin x}$."
 ],
 "topic": "부분적분 — 분모의 제곱을 미분의 결과로 보기",
 "concepts": [
  {
   "h": "부분적분",
   "p": [
    "분모 제곱."
   ]
  },
  {
   "h": "연속인 부정적분",
   "p": [
