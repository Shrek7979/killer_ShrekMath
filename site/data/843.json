 "steps": [
  {
   "n": 1,
   "text": "$g'(x)=f(x+2)-f(x)$ 이고, $f(x)=x^{3}+\\cdots$ 이므로 $(x+2)^{3}-x^{3}=6 x^{2}+\\cdots$ 에서 $g'(x)$ 는 최고차항의 계수가 $6$ 인 이차함수이다.",
   "uses": [
    "C2"
   ],
   "title": "$g'$ 차수"
  },
  {
   "n": 2,
   "text": "$g'(0)=g'(3)=0$ 이므로 $g'(x)=6 x(x-3)$ 이고, $g(x)$ 는 $x=0$ 에서 극대, $x=3$ 에서 극소이다.",
   "uses": [
    "C3"
   ],
   "title": "$g'$"
  },
  {
   "n": 3,
   "text": "$$g(0)-g(3)=-\\int_{0}^{3}g'(x)dx=\\int_{0}^{3}(18 x-6 x^{2})dx=81-54=27$$",
   "uses": [
    "C3"
   ],
   "title": "차"
  },
  {
   "n": 4,
   "text": "$g(3)=0$ 이므로 극댓값은 $g(0)=27$ 이다.",
   "uses": [
    "C4"
   ],
   "title": "답"
  }
 ],
