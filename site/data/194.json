 "steps": [
  {
   "n": 1,
   "text": "$t=\\ln 2$ 일 때 $x=2+\\frac{1}{2}=\\frac{5}{2}$ , $y=2-\\frac{1}{2}=\\frac{3}{2}$ 이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 2,
   "text": "$\\frac{dx}{dt}=e^{t}-e^{-t}$ , $\\frac{dy}{dt}=e^{t}+e^{-t}$ 이므로 $t=\\ln 2$ 에서 $\\frac{dy}{dx}=\\frac{\\frac{5}{2}}{\\frac{3}{2}}=\\frac{5}{3}$ 이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 3,
   "text": "접선의 방정식은 $y=\\frac{5}{3}\\left(x-\\frac{5}{2}\\right)+\\frac{3}{2}=\\frac{5}{3}x-\\frac{8}{3}$ 이므로 $x$ 절편은 $\\frac{8}{5}$ , $y$ 절편은 $-\\frac{8}{3}$ 이다.",
   "uses": [],
   "title": ""
  },
  {
   "n": 4,
   "text": "삼각형의 넓이는 $\\frac{1}{2}\\times \\frac{8}{5}\\times \\frac{8}{3}=\\frac{32}{15}$ 이므로 $p+q=15+32=47$ 이다.",
   "uses": [],
   "title": ""
  }
 ],
