 "steps": [
  {
   "n": 1,
   "text": "부분적분법에 의하여 $a_{n+1}=\\left[x(\\ln x)^{n+1}\\right]_{1}^{e}-(n+1)\\int_{1}^{e}(\\ln x)^{n}dx=e-(n+1)a_{n}$",
   "uses": [],
   "title": ""
  },
  {
   "n": 2,
   "text": "$1 \\le x \\le e$에서 $0 \\le \\ln x \\le 1$이므로 $a_{n}>0$이고, 위 식에서 $(n+1)a_{n}=e-a_{n+1}<e$, 즉 $0<a_{n}<\\frac{e}{n+1}$이므로 $\\lim_{n \\to \\infty}a_{n}=0$",
   "uses": [],
   "title": ""
  },
  {
   "n": 3,
   "text": "$n a_{n}=e-a_{n+1}-a_{n}$이므로 $\\alpha=\\lim_{n \\to \\infty}n a_{n}=e$",
   "uses": [],
   "title": ""
  },
  {
   "n": 4,
   "text": "$a_{1}=\\left[x \\ln x-x \\right]_{1}^{e}=1$이므로 $a_{2}=e-2$, $a_{3}=e-3(e-2)=6-2 e$, $a_{4}=e-4(6-2 e)=9 e-24$",
   "uses": [],
   "title": ""
  },
  {
   "n": 5,
   "text": "$e$는 무리수이므로 $p=9$, $q=-24$이고 $p-q=33$",
   "uses": [],
   "title": ""
  }
 ],
