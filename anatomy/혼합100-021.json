 "steps": [
  {
   "title": "좌표",
   "text": "${\\mathrm{O}}$ 를 원점, ${\\mathrm{A}}(1,\\,0)$ 이라 하면 ${\\mathrm{P}}(\\cos \\theta,\\,\\sin \\theta)$ 이고, 점 ${\\mathrm{P}}$ 에서의 접선 $x \\cos \\theta+y \\sin \\theta=1$ 이 $x$ 축과 만나는 점은 ${\\mathrm{Q}}\\left(\\frac{1}{\\cos \\theta},\\,0 \\right)$ 이다.",
   "uses": [
    "C1",
    "C2"
   ]
  },
  {
   "title": "길이",
   "text": "$$\\overline{{\\mathrm{AQ}}}=\\frac{1-\\cos \\theta}{\\cos \\theta},\\,\\,\\overline{{\\mathrm{PQ}}}=\\tan \\theta,\\,\\,\\overline{{\\mathrm{AP}}}=2 \\sin \\frac{\\theta}{2},\\,\\,f(\\theta)=\\frac{1}{2}\\times \\frac{1-\\cos \\theta}{\\cos \\theta}\\times \\sin \\theta$$",
   "uses": [
    "C2"
   ]
  },
  {
   "title": "$f$",
   "text": "$\\lim_{\\theta \\to 0+}\\frac{1-\\cos \\theta}{\\theta^{2}}=\\frac{1}{2}$ 이므로 $\\lim_{\\theta \\to 0+}\\frac{f(\\theta)}{\\theta^{3}}=\\frac{1}{4}$ 이다.",
   "uses": [
    "C2"
   ]
  },
  {
   "title": "둘레",
   "text": "또 $\\frac{\\overline{{\\mathrm{AQ}}}}{\\theta}\\to 0$ , $\\frac{\\overline{{\\mathrm{PQ}}}}{\\theta}\\to 1$ , $\\frac{\\overline{{\\mathrm{AP}}}}{\\theta}\\to 1$ 이므로 둘레의 길이를 $s(\\theta)$ 라 하면 $\\frac{s(\\theta)}{\\theta}\\to 2$ 이다. $r(\\theta)=\\frac{2 f(\\theta)}{s(\\theta)}$ 이므로",
   "uses": [
    "C2"
   ]
  },
  {
   "title": "$r$",
   "text": "$$\\lim_{\\theta \\to 0+}\\frac{r(\\theta)}{\\theta^{2}}=\\lim_{\\theta \\to 0+}\\frac{2 \\times \\frac{f(\\theta)}{\\theta^{3}}}{\\frac{s(\\theta)}{\\theta}}=\\frac{1}{4}$$",
   "uses": [
    "C2"
   ]
  },
  {
   "title": "답",
   "text": "이다. 따라서 $k=\\lim_{\\theta \\to 0+}\\frac{\\left\\{\\frac{r(\\theta)}{\\theta^{2}}\\right\\}^{2}}{\\frac{f(\\theta)}{\\theta^{3}}}=\\frac{\\frac{1}{16}}{\\frac{1}{4}}=\\frac{1}{4}$ 이고, $100 k=25$ 이다.",
   "uses": [
    "C3",
    "C4"
   ]
  }
 ],
