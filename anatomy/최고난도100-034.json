    "C2"
   ]
  },
  {
   "title": "둘째 적분",
   "text": "$$\\int_{2}^{e}\\frac{\\ln 2 t}{2 t}dt=\\frac{1}{4}\\left[(\\ln 2 t)^{2}\\right]_{2}^{e}=\\frac{(1+\\ln 2)^{2}-4(\\ln 2)^{2}}{4}$$",
   "uses": [
    "C2"
   ]
  },
  {
   "title": "정리",
