  {
   "title": "식",
   "text": "$$\\overline{{\\mathrm{AB}}}=L(\\theta)=\\frac{1}{\\sin \\theta}+\\frac{8}{\\cos \\theta}$$",
   "uses": [
    "C2"
   ]
